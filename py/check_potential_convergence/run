# ##################
PYTHON=/home/gala/miniconda3/envs/agamaBoTorch/bin/python3
CHECK=/home/gala/Agama/py/check_potential_convergence/check_potential_convergence.py
HARNESS=/home/gala/Agama/py/Fornax_P21_PCA_w3Sersic_orblib_exp.py
CHECKRES=/home/gala/Agama/py/potential_checks

STAMP=$(date +%Y%m%d_%H%M%S)
MODELS="$CHECKRES/models_potential_check_q1_${STAMP}.txt"
OUT="$CHECKRES/fields_q1_dense_${STAMP}"

(
  set -o noclobber
  head -n 2 "$CHECKRES/models_potential_check.txt" > "$MODELS"
) &&
"$PYTHON" "$CHECK" \
  --models "$MODELS" --harness "$HARNESS" --validate-inputs &&
"$PYTHON" "$CHECK" \
  --models "$MODELS" --harness "$HARNESS" \
  --threads 1 \
  --radial-nodes 23,46,92,184 \
  --angular-orders 4,8,12,16,24 \
  --radii 192 --angles 17 \
  --rms-tol 1e-4 --max-tol 1e-3 \
  --output "$OUT"
